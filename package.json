{
  "name": "sketchlab-rescript",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "rescript && vite",
    "dev:res": "concurrently -k \"rescript watch\" \"vite\"",
    "res:build": "rescript",
    "res:format": "rescript format",
    "build": "rescript build --warn-error +110 && vite build",
    "test": "rescript && node rescript/TestSuite.res.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@rescript/react": "^0.15.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "rescript": "^12.3.0",
    "vite": "^6.0.7"
  }
}
